# JRepoFlow needs at least one configured chat-model provider.
# Copy this file to .env and fill only the provider you use.

# ===== Chat model =====
GLM_API_KEY=
GLM_MODEL=glm-4.5

# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# KIMI_API_KEY=
# KIMI_MODEL=kimi-k2.5
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# STEP_API_KEY=
# STEP_MODEL=step-3.5-flash
# STEP_BASE_URL=https://api.stepfun.com/v1

# Other compatible adapters supported by the codebase:
# HUNYUAN_API_KEY=       HUNYUAN_MODEL=       HUNYUAN_BASE_URL=
# FREELLMAPI_API_KEY=    FREELLMAPI_MODEL=    FREELLMAPI_BASE_URL=
# XFYUN_MAAS_API_KEY=    XFYUN_MAAS_MODEL=    XFYUN_MAAS_BASE_URL=
# AGNES_API_KEY=         AGNES_MODEL=          AGNES_BASE_URL=

# ===== Code embedding / RAG =====
# The default setup uses local Ollama and needs no API key.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=

# ===== Memory =====
# Maintain an incremental Session Memory before the hard compaction threshold.
# If the summary is unavailable or ineffective, JRepoFlow falls back to a full summary.
JREPOFLOW_SESSION_MEMORY_COMPACTION_ENABLED=false
# JREPOFLOW_MEMORY_DIR=/absolute/path/to/memory

# ===== MCP =====
# Config files:
#   user:    ~/.jrepoflow/mcp.json
#   project: .jrepoflow/mcp.json
# Variables in MCP config can reference ${PROJECT_DIR}, ${HOME}, or ${VAR}.
# REMOTE_TOKEN=
# JREPOFLOW_MCP_INITIALIZE_TIMEOUT_SECONDS=30

# ===== LLM timeout and retry =====
# These options are Java system properties. Example:
# java -Djrepoflow.llm.read.timeout.seconds=600 -jar target/jrepoflow-1.0-SNAPSHOT.jar
# jrepoflow.llm.connect.timeout.seconds=60
# jrepoflow.llm.read.timeout.seconds=300
# jrepoflow.llm.write.timeout.seconds=60
# jrepoflow.llm.call.timeout.seconds=600
# jrepoflow.llm.retry.max-attempts=3
# jrepoflow.llm.retry.base-delay.millis=500
# jrepoflow.llm.retry.max-delay.millis=30000

# Optional ReAct safeguards. Positive values enable the corresponding limit.
# jrepoflow.react.hard.max.iterations=100
# jrepoflow.react.token.budget=200000
# jrepoflow.react.stagnation.window=6

# ===== Local storage and logging =====
JREPOFLOW_LOG_LEVEL=INFO
# JREPOFLOW_LOG_DIR=/absolute/path/to/logs
# JREPOFLOW_AUDIT_DIR=/absolute/path/to/audit
